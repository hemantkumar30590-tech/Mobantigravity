#!/data/user/0/ai.antigem/files/usr/bin/env python3
"""Tiny localhost bridge: web UI focus events -> Android Gboard toggle via Native Accessibility Bridge (Zero ADB)."""
import json
import os
import subprocess
import threading
import time
import urllib.request
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LOG = os.path.expanduser("~/gem_ime_bridge.log")
NATIVE_URL = "http://127.0.0.1:8898"
_lock = threading.Lock()
_last_toggle = 0.0


def log(msg):
    with open(LOG, "a") as f:
        f.write(datetime.now().strftime("%H:%M:%S") + " " + msg + "\n")


def native_set_ime(wanted):
    """Call MobAntigravity native accessibility bridge without ADB."""
    endpoint = "/ime/on" if wanted else "/ime/off"
    try:
        req = urllib.request.Request(f"{NATIVE_URL}{endpoint}")
        with urllib.request.urlopen(req, timeout=0.8) as r:
            data = json.loads(r.read().decode())
            return data.get("ok", False)
    except Exception:
        return False


def adb_ime_state():
    try:
        out = subprocess.run(
            "adb shell 'dumpsys input_method | grep -m1 -o \"mInputShown=[a-z]*\"'",
            shell=True, capture_output=True, text=True, timeout=2,
        ).stdout
        return "mInputShown=true" in out
    except Exception:
        return None


def adb_x11_focused():
    try:
        out = subprocess.run(
            "adb shell 'dumpsys window | grep -m1 mCurrentFocus'",
            shell=True, capture_output=True, text=True, timeout=2,
        ).stdout
        return "ai.antigem.x11" in out
    except Exception:
        return False


def set_ime(wanted):
    global _last_toggle
    # Several focus events fire for the same tap. Debounce them.
    with _lock:
        now = time.monotonic()
        if now - _last_toggle < 0.6:
            return

        # 1. Primary path: Native Accessibility Bridge (Zero ADB, instant)
        if native_set_ime(wanted):
            _last_toggle = now
            log(f"Native bridge: set IME to {wanted}")
            return

        # 2. Fallback path: ADB (if Accessibility Bridge is offline and ADB is paired)
        if not adb_x11_focused():
            return
        current = adb_ime_state()
        if current is None or current == wanted:
            return
        _last_toggle = now
        subprocess.run("adb shell input keyevent 4", shell=True,
                       capture_output=True, timeout=3)
        log(f"ADB fallback: toggled keyevent 4 for wanted={wanted}")


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        log("GET " + self.path)
        if "/ime/on" in self.path:
            set_ime(True)
        elif "/ime/off" in self.path:
            set_ime(False)
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Access-Control-Allow-Origin: *")
        self.end_headers()
        self.wfile.write(b"ok")

    def log_message(self, *args):
        pass


ThreadingHTTPServer(("127.0.0.1", 8899), Handler).serve_forever()
