#!/data/user/0/ai.antigem/files/usr/bin/env python3
"""Tiny localhost bridge: web UI focus events -> Android Gboard toggle."""
import os
import subprocess
import threading
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LOG = os.path.expanduser("~/gem_ime_bridge.log")
_lock = threading.Lock()
_last_toggle = 0.0


def log(msg):
    with open(LOG, "a") as f:
        f.write(datetime.now().strftime("%H:%M:%S") + " " + msg + "\n")


def ime_state():
    try:
        out = subprocess.run(
            "adb shell 'dumpsys input_method | grep -m1 -o \"mInputShown=[a-z]*\"'",
            shell=True, capture_output=True, text=True, timeout=8,
        ).stdout
        return "mInputShown=true" in out
    except Exception:
        return None


def x11_focused():
    try:
        out = subprocess.run(
            "adb shell 'dumpsys window | grep -m1 mCurrentFocus'",
            shell=True, capture_output=True, text=True, timeout=8,
        ).stdout
        return "ai.antigem.x11" in out
    except Exception:
        return False


def set_ime(wanted):
    global _last_toggle
    # Several focus events fire for the same tap. Debounce them, otherwise
    # BACK toggles the keyboard twice (on then off) or closes the X11 activity.
    with _lock:
        now = time.monotonic()
        if now - _last_toggle < 1.0:
            return
        if not x11_focused():
            return
        current = ime_state()
        if current is None or current == wanted:
            return
        _last_toggle = now
        subprocess.run("adb shell input keyevent 4", shell=True,
                       capture_output=True, timeout=8)


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        log("GET " + self.path)
        if "/ime/on" in self.path:
            set_ime(True)
        elif "/ime/off" in self.path:
            set_ime(False)
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(b"ok")

    def log_message(self, *args):
        pass


ThreadingHTTPServer(("127.0.0.1", 8899), Handler).serve_forever()
